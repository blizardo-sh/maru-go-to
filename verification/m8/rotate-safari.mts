import './guard.mjs';import {readFileSync,writeFileSync} from 'node:fs';import {connectDatabase} from '../../src/server/db';import {createLink,consumeLink} from '../../src/server/auth';import assert from 'node:assert/strict';const r=JSON.parse(readFileSync('.local/runtime.json','utf8')),db=connectDatabase(r.database);try{const email='m8-safari-'+crypto.randomUUID()+'@example.test',password=crypto.randomUUID()+crypto.randomUUID(),link=await createLink(db,'invite',email,null);assert.equal(await consumeLink(db,'invite',link.token,password,'M8 Safari'),true);const owner=(await db.sql`select id from users where email=${email}`)[0].id;r.priorSyntheticProfiles??=[];r.priorSyntheticProfiles.push(r.browserUsers[2]);r.browserUsers[2]={email,password,owner};writeFileSync('.local/runtime.json',JSON.stringify(r),{mode:0o600});console.log('New isolated Safari profile; previous synthetic progress retained.');}finally{await db.sql.close();}