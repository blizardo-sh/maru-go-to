import './guard.mjs';import {readFileSync,writeFileSync}from'node:fs';import{connectDatabase}from'../../src/server/db';import{createLink,consumeLink}from'../../src/server/auth';import assert from'node:assert/strict';const r=JSON.parse(readFileSync('.local/runtime.json','utf8')),db=connectDatabase(r.database);assert.ok(!r.finalProfiles,'Final profiles already prepared');try{r.priorSyntheticProfiles??=[];r.priorSyntheticProfiles.push(...r.browserUsers);r.browserUsers=[];for(const label of ['chrome','webkit','safari','protocol','video']){const email='m8-final-'+label+'-'+crypto.randomUUID()+'@example.test',password=crypto.randomUUID()+crypto.randomUUID(),link=await createLink(db,'invite',email,null);assert.equal(await consumeLink(db,'invite',link.token,password,'Проверка кандидата M8'),true);const owner=(await db.sql`select id from users where email=${email}`)[0].id,user={email,password,owner};if(label==='video')r.videoUser=user;else r.browserUsers.push(user);}r.finalProfiles=true;writeFileSync('.local/runtime.json',JSON.stringify(r),{mode:0o600});console.log('Five fresh final-run profiles; previous synthetic progress retained.');}finally{await db.sql.close();}