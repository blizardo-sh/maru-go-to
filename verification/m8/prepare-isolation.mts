import './guard.mjs';import {readFileSync,writeFileSync} from 'node:fs';import{connectDatabase}from'../../src/server/db';import{createLink,consumeLink}from'../../src/server/auth';import assert from'node:assert/strict';const r=JSON.parse(readFileSync('.local/runtime.json','utf8')),db=connectDatabase(r.database);assert.ok(!r.hiddenUsers&&!r.lifecycleUsers&&!r.manualUsers,'Never replace existing prepared profiles');try{for(const field of ['hiddenUsers','lifecycleUsers','manualUsers']){r[field]=[];for(let n=0;n<(field==='hiddenUsers'?2:1);n++){const email='m8-'+field.toLowerCase()+'-'+crypto.randomUUID()+'@example.test',password=crypto.randomUUID()+crypto.randomUUID(),link=await createLink(db,'invite',email,null);assert.equal(await consumeLink(db,'invite',link.token,password,'M8 mobile emulation'),true);const owner=(await db.sql`select id from users where email=${email}`)[0].id;r[field].push({email,password,owner});}}writeFileSync('.local/runtime.json',JSON.stringify(r),{mode:0o600});console.log('Four isolated hidden/lifecycle/manual profiles prepared.');}finally{await db.sql.close();}