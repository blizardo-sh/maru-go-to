import './guard.mjs';import assert from 'node:assert/strict';import{readFileSync,writeFileSync}from'node:fs';import{connectDatabase}from'../../src/server/db';
const r=JSON.parse(readFileSync('.local/runtime.json','utf8')),p=JSON.parse(readFileSync('.local/rollback-receipts.json','utf8')),db=connectDatabase(r.database),checks=[];
try{for(const [kind,table]of [['learning','learning_attempts'],['reviews','review_attempts']] as const){const value=p[kind],rows=await db.sql.unsafe('select user_id,payload,result from '+table+' where attempt_id=$1',[value.payload.attemptId]);assert.equal(rows.length,1);assert.equal(rows[0].user_id,r.browserUsers[0].owner);assert.deepEqual(rows[0].payload,value.payload);assert.deepEqual(rows[0].result,value.ack);const graded=await db.sql`select count(*)::int as n from review_attempts where attempt_id=${value.payload.attemptId}`;assert.equal(graded[0].n,1);checks.push({queue:kind,receiptRows:rows.length,gradeRows:graded[0].n,payloadAndAckMatch:true});}writeFileSync('checks-m8-rollback-sql.json',JSON.stringify({passed:true,checks},null,2)+'\n');}finally{await db.sql.close();}
