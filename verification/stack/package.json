{
  "name": "japanese-learning-stack-verification",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "typecheck": "bun --bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout 20000",
