      {
        "id": "marugoto.starter-a1.skill.ga_ability",
        "lessonIds": [
          "marugoto.starter-a1.lesson.03",
          "marugoto.starter-a1.lesson.11"
        ],
        "canDoIds": [
          5,
          6,
          28,
          29
        ],
        "title": "N が できます: умение",
