{
  "lessonId": "marugoto.starter-a1.lesson.03",
  "version": "2026-10-21.1",
  "titleRu": "О себе",
  "goals": [
    {
      "id": "l03-introduce",
      "titleRu": "Представиться и рассказать о языках",
      "canDoIds": [
        5
      ],
      "parts": [
        {
          "id": "l03-introduce-01",
          "words": [
            {
              "wordId": "marugoto.starter-a1.word.be25e6ec541a983a",
              "explanationRu": "Говорят при самой первой встрече, перед коротким рассказом о себе.",
              "example": {
                "surface": "はじめまして。イワンです。",
                "kana": "はじめまして。イワンです。",
                "meaningRu": "Рад познакомиться. Я Иван.",
                "segments": [
                  {
                    "surface": "はじめまして。イワンです。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-7f0c6888da65.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.72484669620e4adc",
              "explanationRu": "Вежливая заключительная реплика знакомства; буквальный русский перевод здесь не помогает.",
              "example": {
                "surface": "イワンです。どうぞよろしくおねがいします。",
                "kana": "イワンです。どうぞよろしくおねがいします。",
                "meaningRu": "Я Иван. Очень приятно познакомиться.",
                "segments": [
                  {
                    "surface": "イワンです。どうぞよろしくおねがいします。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-004f4cacf37a.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.58e595c1fa37474d",
              "explanationRu": "Нейтральное «я». Когда собеседнику ясно, о ком речь, слово часто опускают.",
              "example": {
                "surface": "わたしはがくせいです。",
                "kana": "わたしはがくせいです。",
                "meaningRu": "Я студент.",
                "segments": [
                  {
                    "surface": "わたしはがくせいです。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-48c4e90c01bf.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.559067766abda333",
              "explanationRu": "Учащийся, студент; не обозначает профессию преподавателя.",
              "example": {
                "surface": "がくせいです。よろしくおねがいします。",
                "kana": "がくせいです。よろしくおねがいします。",
                "meaningRu": "Я студент. Приятно познакомиться.",
                "segments": [
                  {
                    "surface": "がくせいです。よろしくおねがいします。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-8fe8cf9f95b8.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.b26ab0f21a82d32b",
              "explanationRu": "Инженер. Сохраните отдельную носовую мору ン: エ・ン・ジ・ニ・ア. Долгой гласной в начале нет.",
              "example": {
                "surface": "わたしはエンジニアです。",
                "kana": "わたしはエンジニアです。",
                "meaningRu": "Я инженер.",
                "segments": [
                  {
                    "surface": "わたしはエンジニアです。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-e0b71673ce3f.m4a"
              }
            }
          ],
          "construction": {
            "exerciseId": "marugoto.starter-a1.example.wa_identity.l03.1",
            "explanationRu": "Чтобы назвать себя, профессию или национальность, используйте N1 は N2 です. は здесь читается «ва» и выделяет тему, です делает высказывание вежливым. Если тема уже ясна, её можно опустить.",
            "example": {
              "surface": "わたしはがくせいです。",
              "kana": "わたしはがくせいです。",
              "meaningRu": "Я студент.",
              "segments": [
                {
                  "surface": "わたし"
                },
                {
                  "surface": "は"
                },
                {
                  "surface": "がくせい"
                },
                {
                  "surface": "です"
                },
                {
                  "surface": "。"
                }
              ],
              "audioUrl": "/audio/learning/lesson03-construction-wa-identity.m4a"
            },
            "breakdown": [
              {
                "text": "わたし",
                "explanationRu": "я"
              },
              {
                "text": "は",
                "explanationRu": "Тема высказывания; здесь произносится «ва»."
              },
              {
                "text": "がくせい",
                "explanationRu": "студент"
              },
              {
                "text": "です",
                "explanationRu": "Вежливое завершение именной фразы."
              }
            ]
          }
        },
        {
          "id": "l03-introduce-02",
          "words": [
            {
              "wordId": "marugoto.starter-a1.word.8217225960a91885",
              "explanationRu": "Японский язык: название страны にほん + ご «язык».",
              "example": {
                "surface": "にほんごがすこしできます。",
                "kana": "にほんごがすこしできます。",
                "meaningRu": "Я немного говорю по-японски.",
                "segments": [
                  {
                    "surface": "にほんごがすこしできます。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-cfb6c85dfbd2.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.0375e09aad13f1e2",
              "explanationRu": "Английский язык; в живой речи えい часто звучит как долгий э.",
              "example": {
                "surface": "えいごができます。",
                "kana": "えいごができます。",
                "meaningRu": "Я говорю по-английски.",
                "segments": [
                  {
                    "surface": "えいごができます。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-129f1310a383.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.abf51c53069fc220",
              "explanationRu": "Здесь — уметь говорить на языке. Объект умения отмечается が.",
              "example": {
                "surface": "わたしはにほんごができます。",
                "kana": "わたしはにほんごができます。",
                "meaningRu": "Я могу говорить по-японски.",
                "segments": [
                  {
                    "surface": "わたしはにほんごができます。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-c22930496292.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.9b473beed948c0b3",
              "explanationRu": "Вежливый краткий вопрос о том, откуда собеседник.",
              "example": {
                "surface": "どちらからですか。",
                "kana": "どちらからですか。",
                "meaningRu": "Вы откуда?",
                "segments": [
                  {
                    "surface": "どちらからですか。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-f29181a15427.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.ec82a6a9bdbd0924",
              "explanationRu": "Немного: удобно уточнить, что язык пока знаете в небольшой степени.",
              "example": {
                "surface": "にほんごがすこしできます。",
                "kana": "にほんごがすこしできます。",
                "meaningRu": "Я немного говорю по-японски.",
                "segments": [
                  {
                    "surface": "にほんごがすこしできます。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-dce5349220a1.m4a"
              }
            }
          ],
          "construction": {
            "exerciseId": "marugoto.starter-a1.example.ga_ability.l03.1",
            "explanationRu": "Чтобы сказать, на каком языке вы говорите, используйте название языка с が и できます. Эта форма обозначает умение; для отрицания — できません. Тему わたしは можно опустить, когда ясно, что речь о вас.",
            "example": {
              "surface": "わたしはにほんごができます。",
              "kana": "わたしはにほんごができます。",
              "meaningRu": "Я могу говорить по-японски.",
              "segments": [
                {
                  "surface": "わたし"
                },
                {
                  "surface": "は"
                },
                {
                  "surface": "にほんご"
                },
                {
                  "surface": "が"
                },
                {
                  "surface": "できます"
                },
                {
                  "surface": "。"
                }
              ],
              "audioUrl": "/audio/learning/lesson03-construction-ga-ability.m4a"
            },
            "breakdown": [
              {
                "text": "わたし",
                "explanationRu": "я"
              },
              {
                "text": "は",
                "explanationRu": "Тема высказывания; здесь произносится «ва»."
              },
              {
                "text": "にほんご",
                "explanationRu": "японский язык"
              },
              {
                "text": "が",
                "explanationRu": "Отмечает предмет умения, симпатии или то, что существует, в зависимости от модели."
              },
              {
                "text": "できます",
                "explanationRu": "мочь"
              }
            ]
          }
        },
        {
          "id": "l03-introduce-03",
          "words": [
            {
              "wordId": "marugoto.starter-a1.word.a149298ff8f2e16e",
              "explanationRu": "Сотрудник компании; не название конкретной должности.",
              "example": {
                "surface": "わたしはかいしゃいんです。",
                "kana": "わたしはかいしゃいんです。",
                "meaningRu": "Я сотрудник компании.",
                "segments": [
                  {
                    "surface": "わたしはかいしゃいんです。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-2a4144a17ec9.m4a"
              }
            }
          ],
          "construction": {
            "exerciseId": "marugoto.starter-a1.example.mo_addition.l03.1",
            "explanationRu": "も означает «тоже»: когда профессия или другое свойство совпадает с уже названным, も занимает место は или が. Нужен контекст сравнения: собеседник уже сообщил то же о себе.",
            "example": {
              "surface": "わたしもがくせいです。",
              "kana": "わたしもがくせいです。",
              "meaningRu": "Я тоже студент.",
              "segments": [
                {
                  "surface": "わたし"
                },
                {
                  "surface": "も"
                },
                {
                  "surface": "がくせい"
                },
                {
                  "surface": "です"
                },
                {
                  "surface": "。"
                }
              ],
              "audioUrl": "/audio/learning/lesson03-construction-mo-addition.m4a"
            },
            "breakdown": [
              {
                "text": "わたし",
                "explanationRu": "я"
              },
              {
                "text": "も",
                "explanationRu": "Тоже: добавляет совпадение с уже известным."
              },
              {
                "text": "がくせい",
                "explanationRu": "студент"
              },
              {
                "text": "です",
                "explanationRu": "Вежливое завершение именной фразы."
              }
            ]
          }
        }
      ],
      "videoIds": [
        "marugoto.starter-a1.lesson.03"
      ]
    },
    {
      "id": "l03-business-card",
      "titleRu": "Узнать информацию на визитке",
      "canDoIds": [
        6
      ],
      "parts": [
        {
          "id": "l03-business-card-01",
          "words": [
            {
              "wordId": "marugoto.starter-a1.word.f30b2e71086b8f6b",
              "explanationRu": "Визитная карточка: ищите на ней имя, компанию и контактные данные.",
              "example": {
                "surface": "これはわたしのめいしです。",
                "kana": "これはわたしのめいしです。",
                "meaningRu": "Это моя визитка.",
                "segments": [
                  {
                    "surface": "これはわたしのめいしです。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-f55f170e124f.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.c4ae772a6dc8e374",
              "explanationRu": "Вежливое слово для имени собеседника; своё имя обычно называют без お.",
              "example": {
                "surface": "おなまえはなんですか。",
                "kana": "おなまえはなんですか。",
                "meaningRu": "Как вас зовут?",
                "segments": [
                  {
                    "surface": "おなまえはなんですか。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-f4b48dae9ddd.m4a"
              }
            },
            {
              "wordId": "marugoto.starter-a1.word.71622e15e5c20c28",
              "explanationRu": "Вежливый вопрос о работе собеседника, а не о сегодняшней задаче.",
              "example": {
                "surface": "おしごとはなんですか。",
                "kana": "おしごとはなんですか。",
                "meaningRu": "Кем вы работаете?",
                "segments": [
                  {
                    "surface": "おしごとはなんですか。"
                  }
                ],
                "audioUrl": "/audio/learning/lesson03-word-fd9fb35e9d06.m4a"
              }
            }
          ]
        }
      ],
      "introductionRu": "Учебный образец визитки: さくら会社 / 田中ゆき / エンジニア / でんわ 03-1234-5678. Найдите имя, профессию и телефон по расположению и знакомым словам. Имена и номер здесь вымышлены. Не нужно уметь прочитать каждый иероглиф; сопоставьте вид записи. Обмениваясь визиткой, поверните её к собеседнику."
    }
  ],
