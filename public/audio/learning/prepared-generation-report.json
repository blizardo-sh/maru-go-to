      "durationSeconds": 1.554649,
      "sha256": "fed9c81dfead054f05b05b0680b069d876ed9d8bf856f08b3b1c5023cb226449"
    },
    {
      "audioUrl": "/audio/learning/3e75c9827b8c5d6389ab.m4a",
      "spokenText": "おみやげおかいます。",
