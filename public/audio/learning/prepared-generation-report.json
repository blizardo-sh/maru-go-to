      "durationSeconds": 2.130295,
      "sha256": "9a45c993111a0acebb84d18f604e5b53423c407deb1c033f9fc1a0319ebf0a29"
    },
    {
      "audioUrl": "/audio/learning/9f24be32a29f1e60a13d.m4a",
      "spokenText": "おてらおみました。",
      "bytes": 13327,
      "durationSeconds": 1.368526,
      "sha256": "6295f50307e8929cf2d069422be90fae95a1cf126a93b1a82070952bfb5c548b"
    },
    {
      "audioUrl": "/audio/learning/b809cbde53899ac5ad50.m4a",
      "spokenText": "おみやげおかいました。",
      "bytes": 15442,
      "durationSeconds": 1.693061,
      "sha256": "90fd0772d194a5c476466d1b8aac1a9e916f4e99dae4e8e8300aad8c351578e2"
    },
    {
      "audioUrl": "/audio/learning/8cc45bb356b70da9387f.m4a",
      "spokenText": "おてらおみました。それからかいものおしました。",
      "bytes": 27074,
      "durationSeconds": 3.562812,
      "sha256": "cc3a8162a3f9bd5548acad63936d103c0bbda5e95710c475b8903139e91eea54"
    },
    {
      "audioUrl": "/audio/learning/c13f9234ac595fe74e46.m4a",
      "spokenText": "おてらおみました。それからおみやげおかいました。",
      "bytes": 28662,
      "durationSeconds": 3.853061,
      "sha256": "387a09edac9dc68a77091ef805f0d5c8f175e80b7ec026584b2f077ef79d5494"
    },
    {
      "audioUrl": "/audio/learning/270483c17a53c497f6c2.m4a",
      "spokenText": "すしわおいしかったです。",
      "bytes": 17379,
      "durationSeconds": 1.932698,
      "sha256": "54edadbbf6cc379a069632ab5e41b7114d0fe5bbc40ddd9147c57ce80d0e08bf"
    },
    {
      "audioUrl": "/audio/learning/075ba68c3906260a043e.m4a",
      "spokenText": "すしわおいしかったです。でもたかかったです。",
      "bytes": 28114,
      "durationSeconds": 3.685805,
      "sha256": "1e30f758a21637bdb5a8ad6d865a878df3f8c47ba9333d97f5f8596d86f9b1a4"
    },
    {
      "audioUrl": "/audio/learning/5800af90bf46a80950e4.m4a",
      "spokenText": "かぶきおみました。",
