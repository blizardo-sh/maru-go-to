      "sha256": "5ba93d911cba4eebbdd26cfb1de65e11d86a946c98baaf7779246e29c4576bd2"
    },
    {
      "audioUrl": "/audio/learning/1cd7ae5050dbd32ebb07.m4a",
      "spokenText": "りょこうわたのしかったです。",
