      "durationSeconds": 1.541995,
      "sha256": "4c3a7cfff2d0421facafc745a570b3349396eb86c70747f68550f4d26fa1029f"
    },
    {
      "audioUrl": "/audio/learning/9d5d5d83ce3bf7268f3f.m4a",
      "spokenText": "ははにハンカチおあげます。",
      "bytes": 19072,
      "durationSeconds": 2.251111,
      "sha256": "2242c4573f0b6424d509cc583565dacddb80db10456505f54bd08cf4555086ba"
    },
    {
      "audioUrl": "/audio/learning/caf3fc66570ae225a123.m4a",
      "spokenText": "わたしわバッグがほしいです。",
      "bytes": 19951,
      "durationSeconds": 2.448299,
      "sha256": "91ebc3f9c4bc033cf8a3d68d3dbf7cc0326f58049dfb7c034562a32ca812d1f3"
    },
    {
      "audioUrl": "/audio/learning/f03b98e02a224cefd785.m4a",
      "spokenText": "ともだちにほんおあげます。",
      "bytes": 18883,
      "durationSeconds": 2.204807,
      "sha256": "0330faebd0c7f855d2c8d896c17101969ce401533bc79a8377ede8dc71ce92bf"
    },
    {
      "audioUrl": "/audio/learning/e4340a8738e3521e2006.m4a",
      "spokenText": "ともだちにチョコレートおもらいました。",
      "bytes": 23507,
      "durationSeconds": 2.971066,
      "sha256": "8615dd0ec1e68487abd2bdbe7af501d326f7e380b56cf1ec2e046035ccfd7cfe"
    },
    {
      "audioUrl": "/audio/learning/11c3a67a252d5c86d6dd.m4a",
      "spokenText": "チョコレートおあげます。",
      "bytes": 15472,
      "durationSeconds": 1.715102,
      "sha256": "d14005645658e6de34764c00c4e75343d11b3463d4496bf8689f772133010e41"
    },
    {
      "audioUrl": "/audio/learning/5793595c76e4efc43881.m4a",
      "spokenText": "わたしわともだちにほんおあげます。",
      "bytes": 23152,
      "durationSeconds": 3.017188,
      "sha256": "269bd19c3bfadf2ac8b8692d29984aea96e2478b37134da3d8b2b822437bf37d"
    },
    {
      "audioUrl": "/audio/learning/07f7b9a1f226350e4d45.m4a",
      "spokenText": "わたしわともだちにチョコレートおもらいました。",
      "bytes": 28068,
      "durationSeconds": 3.783447,
      "sha256": "bc749eff8891b8c8847649f6c0ff8e812d232968ef2da58fbd5fff78ba950751"
    },
    {
      "audioUrl": "/audio/learning/48e74f6a84dbe961f3d2.m4a",
