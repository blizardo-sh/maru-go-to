      "sha256": "ea3a129a49f7c7907de286764d6ecb32f216207f64a6edd6c2cba22c5b6f8466"
    },
    {
      "audioUrl": "/audio/learning/812d5f0df20e62aa3e8d.m4a",
      "spokenText": "これわいくらですか。",
      "bytes": 15547,
      "durationSeconds": 1.654059,
      "sha256": "1e8275240d531f3d83e83eda9d6743812a9f53ae70d914d85a89ae74f83b8637"
    },
    {
      "audioUrl": "/audio/learning/f022937252472e7e7ef0.m4a",
      "spokenText": "これおください。",
      "bytes": 13072,
      "durationSeconds": 1.30576,
      "sha256": "d35b1d8420b55806384cf78abb9b6e2d5c23723a7b3e12874345b4f325cb115e"
    },
    {
      "audioUrl": "/audio/learning/d30bce1ab5c7f7702522.m4a",
      "spokenText": "このバッグおください。",
      "bytes": 15878,
      "durationSeconds": 1.816599,
      "sha256": "8b014dd1d526f4fd04de2613a4cccd8d995f899b4712448b540599391647ccf1"
    },
    {
      "audioUrl": "/audio/learning/222bd136f0694cf44560.m4a",
      "spokenText": "このティーシャツおください。",
      "bytes": 17478,
      "durationSeconds": 2.025578,
      "sha256": "8815b2393d3e00d9e056f1a518c64975b8279316fe1c24edd61418af8a8f6bdc"
    },
    {
      "audioUrl": "/audio/learning/0df56b6fac08b51f74e8.m4a",
      "spokenText": "このくつおください。",
      "bytes": 15010,
      "durationSeconds": 1.654059,
      "sha256": "81d2e4d99defdd425845908d97dfd2738da2324426456b81356ccddf060e6580"
    },
    {
      "audioUrl": "/audio/learning/e1f02e76aa2535e22b0e.m4a",
      "spokenText": "デパートでかいものおしました。",
