      "durationSeconds": 2.299365,
      "sha256": "47810b244b3e5a6d0868188b839cd4aaaf58439834f35af9a189bc33158d926e"
    },
    {
      "audioUrl": "/audio/learning/fa830f06b9dc3b7772e0.m4a",
      "spokenText": "きのうはなびおみました。",
      "bytes": 16249,
      "durationSeconds": 1.827619,
      "sha256": "e528527c065572314b41417da7d0849d0f0a115825e43ace6417945e4384774a"
    },
    {
      "audioUrl": "/audio/learning/60e9fb2977f2aac0aa49.m4a",
      "spokenText": "かいものわたのしかったです。",
      "bytes": 20367,
      "durationSeconds": 2.408118,
      "sha256": "495d3a56d88cfd97ef260b7a812ecb618d65d61bbe622aaa4f77fd3236ce39c6"
    },
    {
      "audioUrl": "/audio/learning/542fb46f3069ff9af7d0.m4a",
      "spokenText": "きのうわどこにもいきませんでした。",
      "bytes": 23414,
      "durationSeconds": 2.918957,
      "sha256": "33d6bf5fad579e948d05227a1e74009475c49b4480a05ac7fd9f8bfd619a5afa"
    },
    {
      "audioUrl": "/audio/learning/4ab5553bc86fd32ee788.m4a",
      "spokenText": "きのうそうじおしました。",
      "bytes": 16506,
      "durationSeconds": 1.862449,
      "sha256": "11b67daf6620ddf8285b0f72a5f89f15ccc79b2c483eee17995855fa8c0b7d76"
    },
    {
      "audioUrl": "/audio/learning/a4e9a03360ac5436ec82.m4a",
      "spokenText": "きのうえいがおみませんでした。",
      "bytes": 20907,
      "durationSeconds": 2.454558,
      "sha256": "55a8b4cf3fa226784356f44f8f4fde4cbc5085f0b49c252b2b91e228d56aa13e"
    },
    {
      "audioUrl": "/audio/learning/d6f185a17001067be9c5.m4a",
      "spokenText": "わたしわどこにもいきませんでした。",
      "bytes": 22798,
      "durationSeconds": 2.924308,
      "sha256": "19a736fd2cc6d8e6704d87e75e343139e51a717242d5c7a47c347c559344435a"
    },
    {
      "audioUrl": "/audio/learning/e254ffbb06a110a90bd8.m4a",
      "spokenText": "わたしわなにもしませんでした。",
      "bytes": 20053,
      "durationSeconds": 2.50644,
      "sha256": "7d765af270dcfba684d1348ac23dc028a7e30d94911fb612895b18a8f1f4a85b"
    },
    {
      "audioUrl": "/audio/learning/b19d3567cef1d5fa3c30.m4a",
      "spokenText": "まちわにぎやかでした。",
