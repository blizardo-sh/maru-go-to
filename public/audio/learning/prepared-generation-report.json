      "durationSeconds": 2.455147,
      "sha256": "0e96320e082f83e35f4eb6c14ee2e70ad2c1538c9281b2f7ecf91925f93fb7db"
    },
    {
      "audioUrl": "/audio/learning/2289e7766ca1c256ae71.m4a",
      "spokenText": "とけいおかいました。",
